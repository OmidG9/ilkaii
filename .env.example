# Copy to .env (Prisma CLI, scripts and Next.js all read this file).
# Never commit real credentials.
DATABASE_URL="mysql://ilkaii:change-me@127.0.0.1:3306/ilkaii"
SESSION_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Site identity (optional; admin dashboard can override these at runtime)
NEXT_PUBLIC_SITE_NAME="ilkaii"
NEXT_PUBLIC_SITE_TAGLINE="پوشاکی که داستان تو را روایت میکند"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_IMAGE_HOSTS="res.cloudinary.com"

# SMS: required in production. Leave blank locally to use the in-memory dev adapter.
# The dev OTP endpoint (/api/auth/dev-otp) returns 404 in production.
SMS_API_URL=""
SMS_API_TOKEN=""

# Payment: MOCK is blocked in production. Set ZARINPAL with credentials.
PAYMENT_PROVIDER="MOCK"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# Image storage. Cloudinary requires all three values in production or when selected.
STORAGE_DRIVER="LOCAL"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
