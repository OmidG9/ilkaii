# ====================================
# DATABASE CONFIGURATION
# ====================================
DATABASE_URL="mysql://username:password@localhost:3306/ilkaii"

# ====================================
# APPLICATION SETTINGS
# ====================================
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ====================================
# AUTHENTICATION
# ====================================
NEXTAUTH_SECRET="generate-a-random-32-character-string-here"
NEXTAUTH_URL="http://localhost:3000"

# ====================================
# PAYMENT GATEWAY - ZARINPAL
# ====================================
# Zarinpal Merchant ID (sandbox for testing)
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# Set to "true" for sandbox/testing, "false" for production
ZARINPAL_SANDBOX="true"

# ====================================
# IMAGE UPLOAD - CLOUDINARY
# ====================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ====================================
# EMAIL SERVICE (Optional)
# ====================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SENDER_EMAIL="noreply@ilkaii.com"

# ====================================
# SMS SERVICE (Optional)
# ====================================
# TWILIO_ACCOUNT_SID="your-account-sid"
# TWILIO_AUTH_TOKEN="your-auth-token"
# TWILIO_PHONE_NUMBER="+1234567890"

# ====================================
# LOGGING & MONITORING
# ====================================
# LOG_LEVEL="info"
# SENTRY_DSN="your-sentry-dsn"

# ====================================
# FEATURE FLAGS
# ====================================
ENABLE_GUEST_CHECKOUT="true"
ENABLE_GUEST_CART="true"
