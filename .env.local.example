# .env.local (Local Development)

# Database - Local MySQL
DATABASE_URL="mysql://root:password@localhost:3306/ilkaii"

# Application
NEXT_PUBLIC_API_URL="http://localhost:3000"
NODE_ENV="development"
DEFAULT_USER_ID="your-default-user-id"

# Debug Mode (Optional)
DEBUG=true

# Zarin Pal
ZARINPAL_MERCHANT_ID="your-merchant-id-here"
# To test sandbox mode, use a valid merchant ID and set this to true
ZARINPAL_SANDBOX="false"