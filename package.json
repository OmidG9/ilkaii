{
  "name": "ilkaii",
  "version": "1.0.0",
  "description": "White-label Persian fashion e-commerce platform (Next.js 15 + Prisma + MySQL)",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "admin:grant": "tsx scripts/bootstrap-admin.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run type-check && npm run lint && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^18.0.10",
    "ioredis": "^6.1.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.344.0",
    "next": "^15.5.18",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.18",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
